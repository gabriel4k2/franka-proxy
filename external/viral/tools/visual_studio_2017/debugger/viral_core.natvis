<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">


	<!-- =====================================================================
		 Smart pointers
		 ================================================================= -->

	<Type Name="viral_core::auto_pointer&lt;*&gt;">
		<DisplayString Condition="object_ == 0">auto_pointer {{nullptr}}</DisplayString>
		<DisplayString>auto_pointer {object_}</DisplayString>
		<Expand>
			<Item Name="[ptr]">object_</Item>
			<ExpandedItem Condition="object_ != 0">object_</ExpandedItem>
		</Expand>	
	</Type>

	<Type Name="viral_core::shared_pointer&lt;*&gt;">
		<DisplayString Condition="object_ == 0">shared_pointer {{nullptr}}</DisplayString>
		<DisplayString>shared_pointer {object_}</DisplayString>
		<Expand>
			<Item Name="[ptr]">object_</Item>
			<Item Name="[strong ref count]">(*life_manager_).shared_pointer_count_</Item>
			<Item Name="[weak ref count]">(*life_manager_).total_pointer_count_ - (*life_manager_).shared_pointer_count_</Item>
			<Item Name="[total ref count]">(*life_manager_).total_pointer_count_</Item>
			<ExpandedItem Condition="object_ != 0">object_</ExpandedItem>
		</Expand>
	</Type>

	<Type Name="viral_core::weak_pointer&lt;*&gt;">
		<DisplayString Condition="object_ == 0">weak_pointer {{nullptr}}</DisplayString>
		<DisplayString>weak_pointer {object_}</DisplayString>
		<Expand>
			<Item Name="[ptr]">object_</Item>
			<Item Name="[strong ref count]">(*life_manager_).shared_pointer_count_</Item>
			<Item Name="[weak ref count]">(*life_manager_).total_pointer_count_ - (*life_manager_).shared_pointer_count_</Item>
			<Item Name="[total ref count]">(*life_manager_).total_pointer_count_</Item>
			<ExpandedItem Condition="object_ != 0">object_</ExpandedItem>
		</Expand>
	</Type>

	<Type Name="viral_core::shared_instance&lt;*&gt;">
		<DisplayString Condition="pointer_.object_ == 0">shared_instance not initialized</DisplayString>
		<DisplayString>shared_instance {pointer_.object_}</DisplayString>
		<Expand>
			<Item Name="[shared_ptr]">pointer_</Item>
			<ExpandedItem>pointer_</ExpandedItem>
		</Expand>
	</Type>




	<!-- =====================================================================
		 Basic containers
		 ================================================================= -->

	<Type Name="viral_core::dynamic_buffer&lt;*&gt;">
		<DisplayString>{{ size={size_} }}</DisplayString>
		<Expand>
			<ArrayItems>
				<Size>size_</Size>
				<ValuePointer>data_</ValuePointer>
			</ArrayItems>
		</Expand>
	</Type>

	<Type Name="viral_core::array&lt;*&gt;">
		<DisplayString>{{ size={size_} }}</DisplayString>
		<Expand>
			<Item Name="[capacity]">capacity_</Item>
			<ArrayItems>
				<Size>size_</Size>
				<ValuePointer>data_</ValuePointer>
			</ArrayItems>
		</Expand>
	</Type>

	<Type Name="viral_core::list&lt;*&gt;">
		<DisplayString>{{ size={size_} }}</DisplayString>
		<Expand>
			<LinkedListItems>
				<Size>size_</Size>
				<HeadPointer>first_</HeadPointer>
				<NextPointer>next_</NextPointer>
				<ValueNode>value_</ValueNode>
			</LinkedListItems>
		</Expand>
	</Type>

	<Type Name="viral_core::string">
		<DisplayString>{buffer_.data_,s8}</DisplayString>
		<StringView>buffer_.data_,s8</StringView>
		<Expand>
			<ExpandedItem>buffer_</ExpandedItem>
		</Expand>
	</Type>


	<!-- =====================================================================
		 Special containers
		 ================================================================= -->

	<Type Name="viral_core::owning_list&lt;*&gt;">
		<AlternativeType Name="viral_core::owning_array&lt;*&gt;" />
		<AlternativeType Name="viral_core::owning_map&lt;*&gt;" />
		<DisplayString>{pointers_}</DisplayString>
		<Expand>
			<ExpandedItem>pointers_</ExpandedItem>
		</Expand>
	</Type>

	<Type Name="viral_core::heap&lt;*&gt;">
		<DisplayString Condition="array_.size_ == 0">{{ size=0 }}</DisplayString>
		<DisplayString>{{ size={array_.size_} top={array_[0]} }}</DisplayString>
		<Expand>
			<ExpandedItem>array_</ExpandedItem>
		</Expand>
	</Type>

	<Type Name="viral_core::mesh_stream_typed&lt;*&gt;">
		<DisplayString>{buffer_}</DisplayString>
		<Expand>
			<ExpandedItem>buffer_</ExpandedItem>
		</Expand>
	</Type>

	<Type Name="viral_core::batch_list&lt;*&gt;">
		<DisplayString>{{ size={size_} }}</DisplayString>
		<Expand>
			<LinkedListItems>
				<Size>size_</Size>
				<HeadPointer>first_</HeadPointer>
				<NextPointer>next_</NextPointer>
				<ValueNode>value_</ValueNode>
			</LinkedListItems>
		</Expand>
	</Type>




	<!-- =====================================================================
		 Tree containers
		 ================================================================= -->

	<Type Name="viral_core::tree_set&lt;*&gt;">
		<AlternativeType Name="viral_core::tree_map&lt;*&gt;" />
		<DisplayString>{tree_}</DisplayString>
		<Expand>
			<ExpandedItem>tree_</ExpandedItem>
		</Expand>
	</Type>

	<Type Name="viral_core::tree_set_node&lt;*&gt;">
		<DisplayString>{{ key={key_} }}</DisplayString>
		<Expand>
			<Item Name="[key]">key_</Item>
		</Expand>
	</Type>

	<Type Name="viral_core::tree_base&lt;viral_core::tree_set_node&lt;*&gt;&gt;">
		<DisplayString>{{ size={size_} }}</DisplayString>
		<Expand>
			<TreeItems>
				<Size>size_</Size>
				<HeadPointer>root_node_</HeadPointer>
				<LeftPointer>less_</LeftPointer>
				<RightPointer>greater_</RightPointer>
				<ValueNode>key_</ValueNode>
			</TreeItems>
		</Expand>
	</Type>

	<Type Name="viral_core::tree_map_pair&lt;*,*&gt;" IncludeView="ViralMapHelper">
		<DisplayString>{value}</DisplayString>
		<Expand>
			<Item Name="[value]">value</Item>
			<ExpandedItem>key</ExpandedItem>
		</Expand>
	</Type>

	<Type Name="viral_core::tree_map_node&lt;*&gt;">
		<DisplayString>{{ key={key_value_.key} value={key_value_.value} }}</DisplayString>
		<Expand>
			<Item Name="[key]">key_value_.key</Item>
			<Item Name="[value]">key_value_.value</Item>
		</Expand>
	</Type>

	<Type Name="viral_core::tree_base&lt;viral_core::tree_map_node&lt;*&gt;&gt;">
		<DisplayString>{{ size={size_} }}</DisplayString>
		<Expand>
			<TreeItems>
				<Size>size_</Size>
				<HeadPointer>root_node_</HeadPointer>
				<LeftPointer>less_</LeftPointer>
				<RightPointer>greater_</RightPointer>
				<ValueNode Name="[{key_value_.key}]">key_value_,view(ViralMapHelper)</ValueNode>
			</TreeItems>
		</Expand>
	</Type>




	<!-- =====================================================================
		 Iterators
		 ================================================================= -->

	<Type Name="viral_core::iterator&lt;*&gt;">
		<AlternativeType Name="viral_core::const_iterator&lt;*&gt;" />
		<DisplayString Condition="node_ == 0">iterator {{ node=nullptr }}</DisplayString>
		<DisplayString>iterator {{ node={node_} }}</DisplayString>
		<Expand>
			<ExpandedItem>node_</ExpandedItem>
		</Expand>
	</Type>




	<!-- =====================================================================
		 Mulock
		 ================================================================= -->

	<Type Name="viral_core::mulock_access&lt;*&gt;">
		<AlternativeType Name="viral_core::mulock_const_access&lt;*&gt;" />
		<DisplayString Condition="locked_data_ == 0">uninitialized</DisplayString>
		<DisplayString>{{ id={locked_id_.pointer_.object_} data={(*locked_data_)} }}</DisplayString>
		<Expand>
			<Item Name="[id]">locked_id_</Item>
			<ExpandedItem>locked_data_</ExpandedItem>
		</Expand>
	</Type>




  <!-- =====================================================================
		 Geometry
		 ================================================================= -->

  <Type Name="viral_core::vector">
    <DisplayString>x={x} y={y} z={z}</DisplayString>
    <Expand>
      <ExpandedItem>x</ExpandedItem>
      <ExpandedItem>y</ExpandedItem>
      <ExpandedItem>z</ExpandedItem>
    </Expand>
  </Type>
  



	<!-- =====================================================================
		 Utilities
		 ================================================================= -->

	<Type Name="viral_core::signal">
		<DisplayString>{signal_value_}</DisplayString>
	</Type>


</AutoVisualizer>





















